for f in debian/bootstrap.toml.in debian/cargo-X.Y.bash-completion.in debian/cargo-X.Y-doc.docs.in debian/cargo-X.Y.install.in debian/cargo-X.Y.manpages.in debian/cargo-X.Y.sh.in debian/libstd-rust-X.Y-dev.install.in debian/libstd-rust-X.Y-dev.lintian-overrides.in debian/libstd-rust-X.Y.install.in debian/libstd-rust-X.Y.lintian-overrides.in debian/not-installed.in debian/rustc-X.Y.install.in debian/rustc-X.Y.links.in debian/rustc-X.Y.lintian-overrides.in debian/rustc-X.Y.manpages.in debian/rustfmt-X.Y.install.in debian/rust-X.Y-clippy.install.in debian/rust-X.Y-doc.doc-base.book.in debian/rust-X.Y-doc.doc-base.reference.in debian/rust-X.Y-doc.docs.in debian/rust-X.Y-doc.install.in debian/rust-X.Y-gdb.install.in debian/rust-X.Y-gdb.links.in debian/rust-X.Y-lldb.install.in debian/rust-X.Y-lldb.links.in debian/rust-X.Y-miri.install.in debian/rust-X.Y-src.install.in debian/rust-X.Y-src.links.in debian/rust-X.Y-src.lintian-overrides.in debian/watch-beta.in debian/bin/cargo.in debian/bin/cargo-X.Y-unstable-miri.in; do \
	f2=$(echo $f | sed 's/\.in$//;s/X\.Y/1.95/'); \
	echo "$f => $f2"; \
	sed -e 's|@RUST_VERSION@|1.95|g' \
	    -e 's|@RUST_LONG_VERSION@|1.95.0|g' \
	    -e 's|@RUST_PREV_VERSION@|1.94|g' \
	    -e 's|@RUST_NEXT_VERSION@|1.96|g' \
	    -e 's|@LLVM_VERSION_MAJOR@|22|g' \
		$f > $f2; \
	chmod --reference=$f $f2; \
done
