Index: rustc-1.95.0-src/tests/rustdoc-gui/scrape-examples-fonts.goml
===================================================================
--- rustc-1.95.0-src.orig/tests/rustdoc-gui/scrape-examples-fonts.goml
+++ rustc-1.95.0-src/tests/rustdoc-gui/scrape-examples-fonts.goml
@@ -1,7 +1,7 @@
 // This test ensures that the correct font is used in scraped examples.
 go-to: "file://" + |DOC_PATH| + "/scrape_examples/fn.test_many.html"
 
-store-value: (font, '"Fira Sans", Arial, NanumBarunGothic, sans-serif')
+store-value: (font, '"Fira Sans", Arial, sans-serif')
 
 wait-for-css: (".scraped-example-title", {"font-family": |font|})
 wait-for-css: (".more-examples-toggle summary", {"font-family": |font|})
