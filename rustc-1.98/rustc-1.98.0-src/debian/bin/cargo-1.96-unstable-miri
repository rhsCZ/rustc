#!/bin/sh

echo "warning: invoking version-pinned Miri; this breaks Rust's usual stability guarantees" >&2
echo "warning: report issues to the package maintainers, not the upstream developers" >&2

export RUSTC_BOOTSTRAP=1
export CARGO=/usr/bin/cargo-1.96

exec /usr/lib/rust-1.96/bin/cargo-miri miri "$@"
