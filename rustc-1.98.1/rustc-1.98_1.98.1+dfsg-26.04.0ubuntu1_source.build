# dpkg-source insists on version-specific orig tarball names, but for local
# packaging we allow one shared orig tarball per upstream version and create
# a symlink for the current Debian version on demand.
if [ ! -e "/root/rustc/rustc-1.98.1/rustc-1.98.1-src/../rustc-1.98_1.98.1+dfsg.orig.tar.xz" ] && [ -n "/root/rustc/rustc-1.98.1/rustc-1.98.1-src/../rustc-1.98_1.98.1+dfsg.orig.tar.xz" ]; then \
	ln -sf "rustc-1.98_1.98.1+dfsg.orig.tar.xz" \
	       "/root/rustc/rustc-1.98.1/rustc-1.98.1-src/../rustc-1.98_1.98.1+dfsg.orig.tar.xz"; \
fi
if [ ! -e "/root/rustc/rustc-1.98.1/rustc-1.98.1-src/../rustc-1.98_1.98.1+dfsg.orig-vendor.tar.xz" ] && [ -n "/root/rustc/rustc-1.98.1/rustc-1.98.1-src/../rustc-1.98_1.98.1+dfsg.orig-vendor.tar.xz" ]; then \
	ln -sf "rustc-1.98_1.98.1+dfsg.orig-vendor.tar.xz" \
	       "/root/rustc/rustc-1.98.1/rustc-1.98.1-src/../rustc-1.98_1.98.1+dfsg.orig-vendor.tar.xz"; \
fi
# The stage0 payload is now carried by rust-stage0-1.95, so keep any
# leftover local orig-stage0 tarball from being auto-included in source
# uploads for rustc-1.96.
if [ -e "/root/rustc/rustc-1.98.1/rustc-1.98.1-src/../rustc-1.98_1.98.1+dfsg.orig-stage0.tar.xz" ]; then \
	mv -f "/root/rustc/rustc-1.98.1/rustc-1.98.1-src/../rustc-1.98_1.98.1+dfsg.orig-stage0.tar.xz" \
	      "/root/rustc/rustc-1.98.1/rustc-1.98.1-src/../rustc-1.98_1.98.1+dfsg.orig-stage0.tar.xz.disabled"; \
fi
# Upstream contains a lot of these
