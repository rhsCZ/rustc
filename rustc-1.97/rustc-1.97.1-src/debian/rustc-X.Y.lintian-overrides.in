# unofficial example script, no dependency needed
rustc-@RUST_VERSION@ binary: missing-dep-for-interpreter /usr/bin/node (does not satisfy nodejs:any) [usr/share/rustc/bin/wasi-node]

# symlinks to other programs
rustc-@RUST_VERSION@ binary: no-manual-page [usr/bin/rust-@RUST_VERSION@-clang]
rustc-@RUST_VERSION@ binary: no-manual-page [usr/bin/rust-@RUST_VERSION@-lld]
rustc-@RUST_VERSION@ binary: no-manual-page [usr/bin/rust-@RUST_VERSION@-llvm-dwp]
