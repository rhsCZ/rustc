Description: Skip root-sensitive and packaging-specific tests
 Several upstream tests assume a non-root environment or a specific rustdoc
 doctest persistence failure mode. Those assumptions do not hold on Ubuntu
 buildds or in the packaged test environment, so skip them there.
Author: OpenAI Codex
Forwarded: not-needed
Last-Update: 2026-07-19
---
This patch header follows DEP-3: http://dep.debian.net/deps/dep3/
--- a/src/tools/rust-installer/test.sh
+++ b/src/tools/rust-installer/test.sh
@@ -986,6 +986,11 @@
 cannot_write_error() {
     # chmod doesn't work on windows
     if [ ! -n "${WINDOWS-}" ]; then
+    # Ubuntu: buildds run as root, so making PREFIX_DIR readonly does not
+    # reliably make the installer fail.
+    if [ "$(id -u)" -eq 0 ]; then
+        return
+    fi
     try sh "$S/gen-installer.sh" \
         --image-dir="$TEST_DIR/image1" \
         --work-dir="$WORK_DIR" \
