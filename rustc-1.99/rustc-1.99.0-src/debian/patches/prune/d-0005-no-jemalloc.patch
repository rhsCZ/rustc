From: Debian Rust Maintainers <pkg-rust-maintainers@alioth-lists.debian.net>
Date: Sat, 2 Oct 2021 01:08:00 +0100
Subject: d-0005-no-jemalloc

Description: remove jemalloc-sys

Forwarded: not-needed
---
 compiler/rustc/Cargo.toml | 6 ------
 src/tools/rust-analyzer/crates/profile/Cargo.toml | 2 --
 src/tools/rust-analyzer/crates/rust-analyzer/Cargo.toml | 4 +---
 3 files changed, 1 insertion(+), 11 deletions(-)

--- a/compiler/rustc/Cargo.toml
+++ b/compiler/rustc/Cargo.toml
@@ -30,6 +30,1 @@
-[dependencies.tikv-jemalloc-sys]
-version = "0.6.1"
-optional = true
-features = ['override_allocator_on_supported_platforms']
-
 [features]
@@ -37,3 +32,2 @@
 check_only = ['rustc_driver_impl/check_only']
-jemalloc = ['dep:tikv-jemalloc-sys', 'rustc_driver_impl/jemalloc']
 llvm = ['rustc_driver_impl/llvm']

Index: rustc-1.99.0-src/src/tools/rust-analyzer/crates/profile/Cargo.toml
===================================================================
--- rustc-1.99.0-src.orig/src/tools/rust-analyzer/crates/profile/Cargo.toml	2026-08-21 18:28:03.910778651 +0200
+++ rustc-1.99.0-src/src/tools/rust-analyzer/crates/profile/Cargo.toml	2026-08-21 18:28:03.929875851 +0200
@@ -13,7 +13,6 @@
 doctest = false
 
 [dependencies]
-jemalloc-ctl = { version = "0.5.4", package = "tikv-jemalloc-ctl", optional = true }
 
 [target.'cfg(all(target_os = "linux", not(target_env = "ohos"), any(target_arch = "x86", target_arch = "x86_64", target_arch = "aarch64")))'.dependencies]
 perf-event = "=0.4.8"
@@ -29,7 +28,6 @@
 
 [features]
 cpu_profiler = []
-jemalloc = ["jemalloc-ctl"]
 
 # Uncomment to enable for the whole crate graph
 # default = [ "cpu_profiler" ]
